[Unit]
Description=Content AI Platform Automation Worker
After=network.target postgresql.service valkey.service
Wants=postgresql.service valkey.service

[Service]
Type=simple
User=contentai
Group=contentai
WorkingDirectory=/var/www/auctorio
EnvironmentFile=/etc/content-ai-platform/app.env
ExecStart=/usr/bin/node /var/www/auctorio/dist/scripts/start-worker-automation.js
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
