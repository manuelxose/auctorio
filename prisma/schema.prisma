generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  active
  suspended
}

enum TopicStatus {
  active
  archived
}

enum FactSourceType {
  manual
  rss
  html
  api
}

enum ContentTextType {
  seo
  instagram
}

enum ContentStatus {
  queued
  processing
  done
  failed
  retryable
  canceled
}

enum JobType {
  scraping
  text
  image
}

enum JobStatus {
  queued
  processing
  done
  failed
  canceled
}

enum LanguageCode {
  es
  en
}

enum SiteType {
  guiatv
  tecnoria
  talkaris
  webhook
  generic_rest
}

enum ProjectGoal {
  article
  landing
  comparison
  faq
  newsletter
  social_pack
  news_article
}

enum ProjectStatus {
  draft
  ai_generated
  qa_failed
  qa_passed
  in_review
  approved
  publish_queued
  published
  publish_failed
}

enum VersionStatus {
  draft
  ai_generated
  qa_failed
  qa_passed
  approved
  published
  archived
}

enum DerivativeType {
  newsletter_subject
  newsletter_intro
  social_post
  social_caption
  social_thread
}

enum PublicationStatus {
  queued
  processing
  draft_synced
  published
  failed
  canceled
}

enum PublicationAction {
  publish
  update
  unpublish
}

enum AssetKind {
  original
  hero
  og
  thumbnail
  social_square
  social_story
}

enum StudioIdentityProviderType {
  oidc
}

enum StudioProvisioningMode {
  invite_only
}

enum StudioUserStatus {
  invited
  active
  suspended
}

enum StudioInvitationStatus {
  pending
  accepted
  revoked
}

enum StudioAccountStatus {
  invited
  active
  suspended
}

enum StudioAccountTokenKind {
  activation
  password_reset
}

enum StudioSessionAuthMode {
  oidc
  password
  google
  launch
}

enum StudioPromptSurface {
  text_seo
  text_instagram
  image_contextual
  image_independent
}

enum StudioPromptScope {
  global
  site
}

enum StudioPromptVersionStatus {
  draft
  approved
  deprecated
}

enum ContentSourceType {
  rss
  atom
  html
  sitemap
  api
  htmllist
  imdb
  manual
}

enum SourceItemStatus {
  discovered
  fetched
  parsed
  duplicate
  rejected
  candidate
  selected
  processed
  failed
}

enum StoryClusterStatus {
  open
  selected
  covered
  rejected
  archived
  developing
  updated
  superseded
}

enum SocialChannel {
  x
  instagram
}

enum SocialContentType {
  x_post
  x_thread
  instagram_caption
  instagram_story
  social_post
}

enum SocialGenerationStatus {
  queued
  processing
  done
  failed
}

enum SocialEditorialStatus {
  draft
  approved
  rejected
}

enum PublishingAccountPlatform {
  website
  x
  instagram
}

enum PublishingAccountStatus {
  pending
  active
  error
  disabled
}

enum PublicationChannel {
  website
  x
  instagram
}

enum PublicationState {
  draft
  ready
  scheduled
  queued
  publishing
  published
  failed
  canceled
  deleted
  unpublished
}

enum EditorialPlanStatus {
  draft
  generating
  ready
  failed
  archived
}

enum EditorialPlanItemStatus {
  proposed
  approved
  rejected
  content_pending
  generating
  content_ready
  review_required
  scheduled
  published
  canceled
}

enum PublicationAttemptStatus {
  queued
  running
  succeeded
  failed
}

enum AutomationState {
  active
  paused
  degraded
}

model Tenant {
  id         String       @id @default(uuid()) @db.Uuid
  name       String       @unique
  slug       String?      @unique
  apiKeyHash String       @unique @map("api_key_hash")
  status     TenantStatus @default(active)
  plan       String?
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  topics                         Topic[]
  facts                          Fact[]
  contentText                    ContentText[]
  contentImage                   ContentImage[]
  jobs                           Job[]
  aiAudit                        AiAudit[]
  sites                          Site[]
  contentProjects                ContentProject[]
  contentVersions                ContentVersion[]
  contentDerivatives             ContentDerivative[]
  publicationJobs                PublicationJob[]
  assetVariants                  AssetVariant[]
  studioIdentityProvider         StudioIdentityProvider?
  studioAccountsLastWorkspace    StudioAccount[]                  @relation("StudioAccountLastWorkspace")
  studioUsers                    StudioUser[]
  studioRoles                    StudioRole[]
  studioInvitations              StudioInvitation[]
  studioUserSessions             StudioUserSession[]
  studioLaunchTickets            StudioLaunchTicket[]
  studioPromptPresets            StudioPromptPreset[]
  studioPromptAssignments        StudioPromptAssignment[]
  contentSources                 ContentSource[]
  sourceItems                    SourceItem[]
  storyClusters                  StoryCluster[]
  socialContents                 SocialContent[]
  publishingAccounts             PublishingAccount[]
  publications                   Publication[]
  publicationAttempts            PublicationAttempt[]
  automationPolicies             AutomationPolicy[]
  campaigns                      Campaign[]
  editorialBriefs                EditorialBrief[]
  auditLogs                      AuditLog[]
  editorialPlans                 EditorialPlan[]
  editorialPlanItems             EditorialPlanItem[]
  socialConnectionSessions       SocialConnectionSession[]
  webDiscoveryQueries            WebDiscoveryQuery[]
  discoveredDomains              DiscoveredDomain[]
  sourceQualityProfiles          SourceQualityProfile[]
  sourceRecommendations          SourceRecommendation[]
  webRetrievals                  WebRetrieval[]
  webUsageRecords                WebUsageRecord[]
  discoveryConfigs               DiscoveryConfig[]
  blockedDomains                 BlockedDomain[]
  SiteSitemap                    SiteSitemap[]
  SiteIndexedPage                SiteIndexedPage[]
  SiteTopicCluster               SiteTopicCluster[]
  SiteEntity                     SiteEntity[]
  SiteInternalLink               SiteInternalLink[]
  SiteIntelligenceProfile        SiteIntelligenceProfile[]
  SearchTarget                   SearchTarget[]
  EditorialPlanGenerationAttempt EditorialPlanGenerationAttempt[]
  connectorInstallations         ConnectorInstallation[]
  operations                     Operation[]
  notifications                  Notification[]
  notificationPreferences        NotificationPreference[]

  @@map("tenants")
}

model Topic {
  id          String      @id @default(uuid()) @db.Uuid
  tenantId    String      @map("tenant_id") @db.Uuid
  title       String
  description String?
  status      TopicStatus @default(active)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  tenant   Tenant           @relation(fields: [tenantId], references: [id])
  facts    Fact[]
  texts    ContentText[]
  images   ContentImage[]
  projects ContentProject[]

  @@unique([tenantId, title])
  @@index([tenantId, status])
  @@map("topics")
}

model Fact {
  id          String         @id @default(uuid()) @db.Uuid
  tenantId    String         @map("tenant_id") @db.Uuid
  topicId     String         @map("topic_id") @db.Uuid
  sourceType  FactSourceType @map("source_type")
  sourceRef   String?        @map("source_ref")
  content     String         @db.Text
  contentHash String         @map("content_hash")
  metadata    Json?
  createdAt   DateTime       @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  topic  Topic  @relation(fields: [topicId], references: [id])

  @@unique([tenantId, topicId, contentHash])
  @@index([tenantId, topicId])
  @@map("facts")
}

model ContentText {
  id                    String          @id @default(uuid()) @db.Uuid
  tenantId              String          @map("tenant_id") @db.Uuid
  topicId               String          @map("topic_id") @db.Uuid
  type                  ContentTextType
  language              LanguageCode
  status                ContentStatus   @default(queued)
  provider              String?
  model                 String?
  prompt                String?         @db.Text
  output                String?         @db.Text
  promptVersion         String?         @map("prompt_version")
  tokensInput           Int?            @map("tokens_input")
  tokensOutput          Int?            @map("tokens_output")
  costUsd               Decimal?        @map("cost_usd") @db.Decimal(12, 6)
  error                 String?         @db.Text
  dedupeHash            String?         @map("dedupe_hash")
  promptPresetVersionId String?         @map("prompt_preset_version_id") @db.Uuid
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")

  tenant              Tenant               @relation(fields: [tenantId], references: [id])
  topic               Topic                @relation(fields: [topicId], references: [id])
  images              ContentImage[]
  versions            ContentVersion[]
  promptPresetVersion StudioPromptVersion? @relation("ContentTextPromptVersion", fields: [promptPresetVersionId], references: [id], onDelete: SetNull)

  @@unique([tenantId, dedupeHash])
  @@index([tenantId, topicId, status])
  @@index([tenantId, promptPresetVersionId])
  @@map("content_text")
}

model ContentImage {
  id                    String        @id @default(uuid()) @db.Uuid
  tenantId              String        @map("tenant_id") @db.Uuid
  topicId               String        @map("topic_id") @db.Uuid
  textId                String?       @map("text_id") @db.Uuid
  status                ContentStatus @default(queued)
  provider              String?
  model                 String?
  prompt                String?       @db.Text
  storagePath           String?       @map("storage_path")
  width                 Int?
  height                Int?
  costUsd               Decimal?      @map("cost_usd") @db.Decimal(12, 6)
  error                 String?       @db.Text
  dedupeHash            String?       @map("dedupe_hash")
  promptPresetVersionId String?       @map("prompt_preset_version_id") @db.Uuid
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  tenant              Tenant               @relation(fields: [tenantId], references: [id])
  topic               Topic                @relation(fields: [topicId], references: [id])
  text                ContentText?         @relation(fields: [textId], references: [id], onDelete: SetNull)
  versions            ContentVersion[]
  assetVariants       AssetVariant[]
  promptPresetVersion StudioPromptVersion? @relation("ContentImagePromptVersion", fields: [promptPresetVersionId], references: [id], onDelete: SetNull)

  @@unique([tenantId, dedupeHash])
  @@index([tenantId, topicId, status])
  @@index([tenantId, textId])
  @@index([tenantId, promptPresetVersionId])
  @@map("content_image")
}

model Job {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  type           JobType
  status         JobStatus @default(queued)
  idempotencyKey String?   @map("idempotency_key")
  attempts       Int       @default(0)
  lastError      String?   @map("last_error") @db.Text
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  startedAt      DateTime? @map("started_at")
  finishedAt     DateTime? @map("finished_at")

  tenant  Tenant    @relation(fields: [tenantId], references: [id])
  aiAudit AiAudit[]

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status, type])
  @@map("jobs")
}

model AiAudit {
  id                    String   @id @default(uuid()) @db.Uuid
  tenantId              String   @map("tenant_id") @db.Uuid
  jobId                 String   @map("job_id") @db.Uuid
  provider              String
  model                 String
  prompt                String   @db.Text
  response              String?  @db.Text
  usageJson             Json?    @map("usage_json")
  promptPresetVersionId String?  @map("prompt_preset_version_id") @db.Uuid
  createdAt             DateTime @default(now()) @map("created_at")

  tenant              Tenant               @relation(fields: [tenantId], references: [id])
  job                 Job                  @relation(fields: [jobId], references: [id])
  promptPresetVersion StudioPromptVersion? @relation("AiAuditPromptVersion", fields: [promptPresetVersionId], references: [id], onDelete: SetNull)

  @@index([tenantId, jobId])
  @@index([tenantId, promptPresetVersionId])
  @@map("ai_audit")
}

model Site {
  id                       String   @id @default(uuid()) @db.Uuid
  tenantId                 String   @map("tenant_id") @db.Uuid
  key                      String
  name                     String
  type                     SiteType
  locale                   String   @default("es-ES")
  baseUrl                  String?  @map("base_url")
  brandVoice               Json?    @map("brand_voice")
  seoRules                 Json?    @map("seo_rules")
  taxonomyMap              Json?    @map("taxonomy_map")
  publishingCredentialsRef String?  @map("publishing_credentials_ref")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  tenant              Tenant                   @relation(fields: [tenantId], references: [id])
  projects            ContentProject[]
  publicationJobs     PublicationJob[]
  assetVariants       AssetVariant[]
  promptPresets       StudioPromptPreset[]
  promptAssignments   StudioPromptAssignment[]
  contentSources      ContentSource[]
  publishingAccounts  PublishingAccount[]
  automationPolicies  AutomationPolicy[]
  publications        Publication[]
  editorialPlans      EditorialPlan[]
  editorialPlanItems  EditorialPlanItem[]
  sitemaps            SiteSitemap[]
  indexedPages        SiteIndexedPage[]
  topicClusters       SiteTopicCluster[]
  entities            SiteEntity[]
  intelligenceProfile SiteIntelligenceProfile?
  searchTargets       SearchTarget[]
  SiteInternalLink    SiteInternalLink[]
  connectorInstallations ConnectorInstallation[]
  operations          Operation[]
  notifications       Notification[]

  @@unique([tenantId, key])
  @@index([tenantId, type])
  @@map("sites")
}

model ContentProject {
  id                    String        @id @default(uuid()) @db.Uuid
  tenantId              String        @map("tenant_id") @db.Uuid
  siteId                String        @map("site_id") @db.Uuid
  topicId               String?       @map("topic_id") @db.Uuid
  title                 String
  brief                 String        @db.Text
  goal                  ProjectGoal   @default(article)
  status                ProjectStatus @default(draft)
  primaryLanguage       String        @default("es") @map("primary_language")
  metadata              Json?
  sourceItemId          String?       @map("source_item_id") @db.Uuid
  clusterId             String?       @map("cluster_id") @db.Uuid
  campaignId            String?       @map("campaign_id") @db.Uuid
  briefId               String?       @map("brief_id") @db.Uuid
  origin                String        @default("manual")
  deletedAt             DateTime?     @map("deleted_at")
  deletedBy             String?       @map("deleted_by")
  deletedByStudioUserId String?       @map("deleted_by_studio_user_id") @db.Uuid
  deletionReason        String?       @map("deletion_reason")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  site               Site                @relation(fields: [siteId], references: [id])
  topic              Topic?              @relation(fields: [topicId], references: [id], onDelete: SetNull)
  sourceItem         SourceItem?         @relation(fields: [sourceItemId], references: [id], onDelete: SetNull)
  cluster            StoryCluster?       @relation(fields: [clusterId], references: [id], onDelete: SetNull)
  campaign           Campaign?           @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  editorialBrief     EditorialBrief?     @relation(fields: [briefId], references: [id], onDelete: SetNull)
  versions           ContentVersion[]
  derivatives        ContentDerivative[]
  publicationJobs    PublicationJob[]
  socialContents     SocialContent[]
  publications       Publication[]
  editorialPlanItems EditorialPlanItem[]

  @@index([tenantId, siteId, status])
  @@index([tenantId, topicId])
  @@index([tenantId, deletedAt])
  @@index([tenantId, sourceItemId])
  @@map("content_projects")
}

model ContentVersion {
  id                     String        @id @default(uuid()) @db.Uuid
  tenantId               String        @map("tenant_id") @db.Uuid
  projectId              String        @map("project_id") @db.Uuid
  contentTextId          String?       @map("content_text_id") @db.Uuid
  contentImageId         String?       @map("content_image_id") @db.Uuid
  versionNumber          Int           @map("version_number")
  status                 VersionStatus @default(draft)
  title                  String?
  excerpt                String?       @db.Text
  bodyHtml               String?       @map("body_html") @db.Text
  seoTitle               String?       @map("seo_title")
  seoDescription         String?       @map("seo_description") @db.Text
  qaReport               Json?         @map("qa_report")
  feedback               String?       @db.Text
  approvedAt             DateTime?     @map("approved_at")
  approvedBy             String?       @map("approved_by")
  approvedByStudioUserId String?       @map("approved_by_studio_user_id") @db.Uuid
  publishedAt            DateTime?     @map("published_at")
  createdAt              DateTime      @default(now()) @map("created_at")
  updatedAt              DateTime      @updatedAt @map("updated_at")

  tenant               Tenant              @relation(fields: [tenantId], references: [id])
  project              ContentProject      @relation(fields: [projectId], references: [id])
  contentText          ContentText?        @relation(fields: [contentTextId], references: [id], onDelete: SetNull)
  contentImage         ContentImage?       @relation(fields: [contentImageId], references: [id], onDelete: SetNull)
  derivatives          ContentDerivative[]
  publicationJobs      PublicationJob[]
  publications         Publication[]
  socialContents       SocialContent[]
  approvedByStudioUser StudioUser?         @relation("StudioUserApprovedVersions", fields: [approvedByStudioUserId], references: [id], onDelete: SetNull)

  @@unique([projectId, versionNumber])
  @@index([tenantId, projectId, status])
  @@index([tenantId, contentTextId])
  @@index([tenantId, contentImageId])
  @@index([tenantId, approvedByStudioUserId])
  @@map("content_versions")
}

model ContentDerivative {
  id        String         @id @default(uuid()) @db.Uuid
  tenantId  String         @map("tenant_id") @db.Uuid
  projectId String         @map("project_id") @db.Uuid
  versionId String         @map("version_id") @db.Uuid
  type      DerivativeType
  title     String?
  body      String         @db.Text
  status    String         @default("done")
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  tenant  Tenant         @relation(fields: [tenantId], references: [id])
  project ContentProject @relation(fields: [projectId], references: [id])
  version ContentVersion @relation(fields: [versionId], references: [id])

  @@index([tenantId, projectId, versionId])
  @@map("content_derivatives")
}

model PublicationJob {
  id                      String            @id @default(uuid()) @db.Uuid
  tenantId                String            @map("tenant_id") @db.Uuid
  siteId                  String            @map("site_id") @db.Uuid
  projectId               String            @map("project_id") @db.Uuid
  versionId               String            @map("version_id") @db.Uuid
  status                  PublicationStatus @default(queued)
  action                  PublicationAction @default(publish)
  idempotencyKey          String?           @map("idempotency_key")
  externalId              String?           @map("external_id")
  externalUrl             String?           @map("external_url")
  requestPayload          Json?             @map("request_payload")
  responsePayload         Json?             @map("response_payload")
  error                   String?           @db.Text
  requestedByStudioUserId String?           @map("requested_by_studio_user_id") @db.Uuid
  publishedAt             DateTime?         @map("published_at")
  createdAt               DateTime          @default(now()) @map("created_at")
  updatedAt               DateTime          @updatedAt @map("updated_at")

  tenant                Tenant         @relation(fields: [tenantId], references: [id])
  site                  Site           @relation(fields: [siteId], references: [id])
  project               ContentProject @relation(fields: [projectId], references: [id])
  version               ContentVersion @relation(fields: [versionId], references: [id])
  requestedByStudioUser StudioUser?    @relation("StudioUserRequestedPublications", fields: [requestedByStudioUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, siteId, status])
  @@index([tenantId, projectId, versionId])
  @@index([tenantId, requestedByStudioUserId])
  // Uniqueness on (tenantId, idempotencyKey) is a partial unique index
  // created manually in migration 20260824000000_social_connections_and_web_discovery
  // (WHERE idempotency_key IS NOT NULL) — Prisma cannot model partial indexes.
  @@map("publication_jobs")
}

model AssetVariant {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  siteId         String?   @map("site_id") @db.Uuid
  contentImageId String    @map("content_image_id") @db.Uuid
  kind           AssetKind @default(original)
  storagePath    String    @map("storage_path")
  mimeType       String    @map("mime_type")
  width          Int?
  height         Int?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  site         Site?        @relation(fields: [siteId], references: [id], onDelete: SetNull)
  contentImage ContentImage @relation(fields: [contentImageId], references: [id], onDelete: Cascade)

  @@index([tenantId, contentImageId, kind])
  @@map("asset_variants")
}

model StudioIdentityProvider {
  id                     String                     @id @default(uuid()) @db.Uuid
  tenantId               String                     @unique @map("tenant_id") @db.Uuid
  type                   StudioIdentityProviderType @default(oidc)
  enabled                Boolean                    @default(false)
  issuer                 String
  clientId               String                     @map("client_id")
  clientSecretCiphertext String?                    @map("client_secret_ciphertext")
  scopes                 String                     @default("openid profile email")
  claimMappings          Json?                      @map("claim_mappings")
  provisioningMode       StudioProvisioningMode     @default(invite_only) @map("provisioning_mode")
  createdAt              DateTime                   @default(now()) @map("created_at")
  updatedAt              DateTime                   @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("studio_identity_providers")
}

model StudioAccount {
  id              String              @id @default(uuid()) @db.Uuid
  email           String              @unique
  passwordHash    String?             @map("password_hash")
  googleSubject   String?             @unique @map("google_subject")
  emailVerifiedAt DateTime?           @map("email_verified_at")
  lastWorkspaceId String?             @map("last_workspace_id") @db.Uuid
  displayName     String?             @map("display_name")
  avatarUrl       String?             @map("avatar_url")
  status          StudioAccountStatus @default(invited)
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  lastWorkspace Tenant?              @relation("StudioAccountLastWorkspace", fields: [lastWorkspaceId], references: [id], onDelete: SetNull)
  users         StudioUser[]
  tokens        StudioAccountToken[]

  @@index([status])
  @@map("studio_accounts")
}

model StudioAccountToken {
  id         String                 @id @default(uuid()) @db.Uuid
  accountId  String                 @map("account_id") @db.Uuid
  kind       StudioAccountTokenKind
  tokenHash  String                 @unique @map("token_hash")
  expiresAt  DateTime               @map("expires_at")
  consumedAt DateTime?              @map("consumed_at")
  createdAt  DateTime               @default(now()) @map("created_at")
  updatedAt  DateTime               @updatedAt @map("updated_at")

  account StudioAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, kind, consumedAt])
  @@index([expiresAt])
  @@map("studio_account_tokens")
}

model StudioUser {
  id          String           @id @default(uuid()) @db.Uuid
  tenantId    String           @map("tenant_id") @db.Uuid
  accountId   String           @map("account_id") @db.Uuid
  email       String
  displayName String           @map("display_name")
  avatarUrl   String?          @map("avatar_url")
  status      StudioUserStatus @default(invited)
  oidcSubject String?          @map("oidc_subject")
  oidcIssuer  String?          @map("oidc_issuer")
  lastLoginAt DateTime?        @map("last_login_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  tenant                   Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account                  StudioAccount            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  roles                    StudioUserRole[]
  sessions                 StudioUserSession[]
  invitations              StudioInvitation[]       @relation("StudioInvitationUser")
  createdInvitations       StudioInvitation[]       @relation("StudioInvitationCreator")
  launchTickets            StudioLaunchTicket[]
  approvedVersions         ContentVersion[]         @relation("StudioUserApprovedVersions")
  requestedPublications    PublicationJob[]         @relation("StudioUserRequestedPublications")
  createdPromptPresets     StudioPromptPreset[]     @relation("StudioPromptPresetCreatedBy")
