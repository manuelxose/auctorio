{
  "name": "auctorio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:studio": "npm --prefix apps/studio-web run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npx prisma migrate deploy && npm run build && npm run build:studio && node --test dist/tests/**/*.test.js",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:live:guiatv": "ts-node scripts/live-guiatv-contract.ts",
    "report:intelligence": "ts-node scripts/intelligence-report.ts",
    "verify:sources:live": "ts-node scripts/live-source-verification.ts",
    "verify:platforms": "ts-node scripts/verify-platform-credentials.ts",
    "dev:studio": "npm --prefix apps/studio-web run dev:ssr",
    "serve:studio": "npm --prefix apps/studio-web run serve:ssr",
    "bootstrap:studio-access": "ts-node scripts/bootstrap-studio-access.ts",
    "start:api": "ts-node scripts/start-api.ts",
    "start:worker:text": "ts-node scripts/start-worker-text.ts",
    "start:worker:image": "ts-node scripts/start-worker-image.ts",
    "start:worker:scraping": "ts-node scripts/start-worker-scraping.ts",
    "start:worker:publishing": "ts-node scripts/start-worker-publishing.ts",
    "start:worker:discovery": "ts-node scripts/start-worker-discovery.ts",
    "start:worker:scheduler": "ts-node scripts/start-worker-scheduler.ts",
    "start:worker:automation": "ts-node scripts/start-worker-automation.ts",
    "start:worker:social": "ts-node scripts/start-worker-social.ts",
    "report:editorial-engine": "ts-node scripts/editorial-engine-fixtures.ts",
    "ops:queue": "ts-node scripts/queue-ops.ts",
    "ops:release-preflight": "ts-node scripts/release-preflight.ts",
    "automation:recover": "ts-node scripts/automation-recover.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.10.2",
    "bullmq": "^4.12.1",
    "cheerio": "^1.0.0-rc.12",
    "fast-xml-parser": "^4.3.5",
    "fastify": "^4.26.2",
    "google-auth-library": "^10.6.1",
    "nodemailer": "^7.0.5",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^20.11.30",
    "@types/nodemailer": "^7.0.11",
    "prisma": "^5.10.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
