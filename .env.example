APP_ENV=local
HOST=0.0.0.0
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
DATABASE_URL=postgresql://user:pass@localhost:5432/content_ai
REDIS_URL=redis://localhost:6379
# Mock providers are DEV-ONLY. In production (NODE_ENV or APP_ENV = production)
# the API/workers fail fast if provider config is missing or set to mock.
TEXT_PROVIDER=deepseek
IMAGE_PROVIDER=siliconflow
STORAGE_ROOT=/var/www/auctorio/storage
LOG_LEVEL=info
DAILY_BUDGET_USD=0
MONTHLY_BUDGET_USD=0
ESTIMATED_TEXT_COST_USD=0
ESTIMATED_IMAGE_COST_USD=0
TEXT_API_BASE_URL=https://api.deepseek.com
TEXT_API_KEY=
TEXT_MODEL=deepseek-chat
TEXT_TEMPERATURE=0.7
TEXT_MAX_TOKENS=800
TEXT_TIMEOUT_MS=60000
TEXT_RETRIES=1
TEXT_COST_PER_1K_INPUT_USD=0
TEXT_COST_PER_1K_OUTPUT_USD=0
IMAGE_API_BASE_URL=https://api.siliconflow.com
IMAGE_API_KEY=
IMAGE_MODEL=black-forest-labs/FLUX.2-pro
IMAGE_TIMEOUT_MS=90000
IMAGE_RETRIES=1
IMAGE_DOWNLOAD_TIMEOUT_MS=90000
IMAGE_DOWNLOAD_RETRIES=1
IMAGE_COST_PER_GEN_USD=0
PUBLISH_TIMEOUT_MS=30000
PUBLISH_DRY_RUN=true
SCRAPE_ALLOWLIST=
SCRAPE_RESPECT_ROBOTS=false
SCRAPE_TIMEOUT_MS=10000
SCRAPE_MIN_DELAY_MS=0
SCRAPE_MAX_ITEMS=20
SCRAPE_MAX_CHARS=4000
SCRAPE_ROBOTS_TTL_MS=21600000
SCRAPE_USER_AGENT=auctorio-bot
# Example credential refs for sites created through /v2/sites:
# GUIATV_PUBLISHER_KEY=<x-admin-key value>
# TECNORIA_PUBLISHER_CREDENTIALS={"email":"admin@example.com","password":"supersecret"}
# WEBHOOK_PUBLISHER_SECRET=<shared secret>
STUDIO_BASE_PATH=/studio
STUDIO_API_INTERNAL_URL=http://127.0.0.1:3000
STUDIO_SESSION_SECRET=change-me-in-production
STUDIO_COOKIE_NAME=studio_session
STUDIO_ALLOWED_HOSTS=localhost,127.0.0.1
# STUDIO_COOKIE_SECURE=true
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.com/v1
SILICONFLOW_IMAGE_MODEL=black-forest-labs/FLUX.2-pro
SILICONFLOW_IMAGE_SIZE=1024x576
SILICONFLOW_IMAGE_FORMAT=png
SILICONFLOW_DEFAULT_PROJECT=shared
SILICONFLOW_OUTPUT_DIR=generated-assets
