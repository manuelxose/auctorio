APP_ENV=local
HOST=0.0.0.0
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
DATABASE_URL=postgresql://user:pass@localhost:5432/content_ai
REDIS_URL=redis://localhost:6379
# Bounded Redis connect and operational CLI waits. Workers fail fast when
# Redis is absent so systemd can restart/degrade them visibly.
REDIS_CONNECT_TIMEOUT_MS=5000
QUEUE_OP_TIMEOUT_MS=5000
# Mock providers are DEV-ONLY. In production (NODE_ENV or APP_ENV = production)
# the API/workers fail fast if provider config is missing or set to mock.
TEXT_PROVIDER=deepseek
IMAGE_PROVIDER=siliconflow
STORAGE_ROOT=/var/www/auctorio/storage
LOG_LEVEL=info
DAILY_BUDGET_USD=0
MONTHLY_BUDGET_USD=0
ESTIMATED_TEXT_COST_USD=0
ESTIMATED_IMAGE_COST_USD=0
TEXT_API_BASE_URL=https://api.deepseek.com
TEXT_API_KEY=
TEXT_MODEL=deepseek-chat
TEXT_TEMPERATURE=0.7
TEXT_MAX_TOKENS=800
TEXT_TIMEOUT_MS=60000
TEXT_RETRIES=1
TEXT_COST_PER_1K_INPUT_USD=0
TEXT_COST_PER_1K_OUTPUT_USD=0
IMAGE_API_BASE_URL=https://api.siliconflow.com
IMAGE_API_KEY=
IMAGE_MODEL=black-forest-labs/FLUX.2-pro
IMAGE_TIMEOUT_MS=90000
IMAGE_RETRIES=1
IMAGE_DOWNLOAD_TIMEOUT_MS=90000
IMAGE_DOWNLOAD_RETRIES=1
IMAGE_COST_PER_GEN_USD=0
PUBLISH_TIMEOUT_MS=30000
PUBLISH_DRY_RUN=true
# Retry policy shared by all BullMQ workers (attempts + exponential backoff)
WORKER_MAX_ATTEMPTS=3
WORKER_BACKOFF_MS=2000
SCRAPE_ALLOWLIST=
SCRAPE_RESPECT_ROBOTS=false
SCRAPE_TIMEOUT_MS=10000
SCRAPE_MIN_DELAY_MS=0
SCRAPE_MAX_ITEMS=20
SCRAPE_MAX_CHARS=4000
SCRAPE_ROBOTS_TTL_MS=21600000
SCRAPE_USER_AGENT=auctorio-bot
# ── Editorial platform: discovery, scheduling, automation ────────────────
# Discovery worker loop interval for refreshing due sources.
DISCOVERY_INTERVAL_MS=60000
# Scheduler worker loop interval for claiming due publications.
SCHEDULER_INTERVAL_MS=10000
SCHEDULER_BATCH_SIZE=20
# Automation planner loop interval.
AUTOMATION_INTERVAL_MS=120000
# Hard safety cap for articles/day that the UI cannot exceed.
AUTOMATION_HARD_MAX_ARTICLES_DAY=20
# Publication retry policy (transient failures).
PUBLICATION_MAX_RETRIES=3
PUBLICATION_RETRY_BASE_MS=60000
# ── Social publishing (server-side credentials, referenced by name) ──────
# X/Twitter (OAuth 1.0a user context). Create a PublishingAccount in the
# Studio with credentialsRef=X_PUBLISHER_CREDENTIALS pointing here.
# X_PUBLISHER_CREDENTIALS={"apiKey":"...","apiSecret":"...","accessToken":"...","accessTokenSecret":"..."}
# Instagram (Graph API). credentialsRef=INSTAGRAM_PUBLISHER_CREDENTIALS.
# INSTAGRAM_PUBLISHER_CREDENTIALS={"accessToken":"...","igUserId":"123456789"}
# Example credential refs for sites created through /v2/sites:
# GUIATV_PUBLISHER_KEY=<x-admin-key value>
# GuiaTV automatic publication uses the destination review endpoint, never a
# direct status=publish write. All four values are required for live approval.
# AUCTORIO_EDITORIAL_REVIEW_KEY=<x-editorial-review-key value>
# AUCTORIO_EDITORIAL_REVIEWER=auctorio-quality-gate
# GUIATV_EDITORIAL_AUTHOR_NAME=Equipo editorial GuíaTV
# GUIATV_EDITORIAL_AUTHOR_ID=guiatv-editorial
# TECNORIA_PUBLISHER_CREDENTIALS={"email":"admin@example.com","password":"supersecret"}
# WEBHOOK_PUBLISHER_SECRET=<shared secret>
# ── Social connections (OAuth / managed provider) ────────────────────────
# Managed provider: Ayrshare (account linking UI + managed tokens).
# When set, "Connect Instagram" / "Connect X" use Ayrshare Link.
SOCIAL_PROVIDER=
AYRSHARE_API_KEY=
# Direct OAuth (Bring Your Own App). Used when SOCIAL_PROVIDER=direct or when
# no managed provider is configured.
# X developer app (OAuth 2.0 + PKCE; scopes tweet.read tweet.write users.read offline.access).
X_CLIENT_ID=
X_CLIENT_SECRET=
# Meta app for Instagram Graph (instagram_basic + instagram_content_publish + pages).
META_APP_ID=
META_APP_SECRET=
# Secret used to encrypt OAuth tokens at rest in the database.
# Generate with: openssl rand -base64 32
SOCIAL_TOKEN_ENCRYPTION_KEY=
# Social provider request timeouts and connection health-check cadence.
SOCIAL_PROVIDER_TIMEOUT_MS=30000
SOCIAL_CONNECTION_HEALTH_MS=21600000
# ── AI web source discovery ───────────────────────────────────────────────
# Web intelligence provider: firecrawl (default) or tavily.
WEB_INTELLIGENCE_PROVIDER=firecrawl
FIRECRAWL_API_KEY=
TAVILY_API_KEY=
WEB_INTELLIGENCE_TIMEOUT_MS=45000
# Discovery worker cadence (default 30 minutes).
WEB_DISCOVERY_INTERVAL_MS=1800000
# Bounded scraping per discovery run.
WEB_DISCOVERY_MAX_SCRAPES_PER_RUN=25
# Cost accounting estimates (USD per operation).
WEB_SEARCH_COST_USD_PER_QUERY=0.001
WEB_SCRAPE_COST_USD_PER_PAGE=0.0015
STUDIO_BASE_PATH=/studio
STUDIO_API_INTERNAL_URL=http://127.0.0.1:3000
STUDIO_SESSION_SECRET=change-me-in-production
STUDIO_COOKIE_NAME=studio_session
STUDIO_ALLOWED_HOSTS=localhost,127.0.0.1
# STUDIO_COOKIE_SECURE=true
# Google Identity Services. Use the same OAuth web-client ID as the frontend
# and add every Studio origin (for example http://localhost:4200) to
# "Authorized JavaScript origins" in Google Cloud Console. No client secret is
# required for this ID-token flow.
GOOGLE_CLIENT_ID=

# ── Source registry HTTP behavior ─────────────────────────────────────────
# Descriptive user agent sent to publishers. Keep the compliance reference.
SCRAPE_USER_AGENT=auctorio-bot/1.0 (+https://studio.example.com/compliance; editorial discovery)
# Connect phase timeout and total response timeout per fetch.
SOURCE_CONNECT_TIMEOUT_MS=5000
SCRAPE_TIMEOUT_MS=10000
# Maximum response body size accepted per fetch.
SOURCE_FETCH_MAX_BYTES=10485760
# Bounded redirect following.
SOURCE_FETCH_MAX_REDIRECTS=5
# Retry only retryable failures (429/5xx/timeouts) with exponential backoff + jitter.
SOURCE_FETCH_RETRY_ATTEMPTS=2
SOURCE_FETCH_BACKOFF_BASE_MS=1000
SOURCE_FETCH_BACKOFF_MAX_MS=30000
# Per-domain concurrency and politeness.
DISCOVERY_MAX_CONCURRENT_PER_DOMAIN=2
DISCOVERY_MIN_INTERVAL_PER_DOMAIN_MS=500
# Feed discovery candidate verification budget.
FEED_DISCOVERY_MAX_CHECKS=14
# Respect robots.txt for source fetches (per-source override via robotsPolicy).
SCRAPE_RESPECT_ROBOTS=false

# ── Enrichment providers (server-side secret references) ──────────────────
# ContentSource.credentialsRef / EnrichmentProvider.credentialsRef point at
# these env var NAMES. The keys are never persisted in the database and never
# returned to the browser.
TMDB_API_KEY=
OMDB_API_KEY=
YOUTUBE_API_KEY=
IMDB_API_KEY=
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.com/v1
SILICONFLOW_IMAGE_MODEL=black-forest-labs/FLUX.2-pro
SILICONFLOW_IMAGE_SIZE=1024x576
SILICONFLOW_IMAGE_FORMAT=png
SILICONFLOW_DEFAULT_PROJECT=shared
SILICONFLOW_OUTPUT_DIR=generated-assets

# ── Phase 5: operations, resilience, backpressure, observability ─────────
# Graceful shutdown budget for every worker process (SIGTERM → in-flight
# jobs finish or are released back to the queue).
WORKER_SHUTDOWN_TIMEOUT_MS=30000
# Worker heartbeat cadence written to the worker_heartbeats table.
WORKER_HEARTBEAT_INTERVAL_MS=15000
# BullMQ lock/stalled-job detection for every queue.
WORKER_LOCK_DURATION_MS=30000
WORKER_STALLED_INTERVAL_MS=30000
WORKER_MAX_STALLED_COUNT=2
# Per-worker bounded concurrency (pattern; uppercase worker name).
# Examples:
#   WORKER_TEXT_CONCURRENCY=2
#   WORKER_IMAGE_CONCURRENCY=1
#   WORKER_SCRAPING_CONCURRENCY=2
#   WORKER_PUBLISHING_CONCURRENCY=1
#   WORKER_DISCOVERY_CONCURRENCY=1
# Queue depth soft limit: enqueue producers defer (delay) instead of dropping.
QUEUE_MAX_DEPTH=10000
# Structured metrics log interval (ingestion/intelligence/generation/
# publishing/infrastructure counters and gauges).
METRICS_LOG_INTERVAL_MS=60000
